# ==============================================================================
# HAICHAIN ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure local values. Do NOT commit real secrets.

# Solana Network Configuration
SOLANA_CLUSTER=devnet
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Relayer & Watchtower Daemon Server
PORT=8089
HOST=127.0.0.1
NODE_ENV=development

# Watchtower Relayer Payer Keypair (Base58 encoded or JSON array)
# Leave blank to auto-generate an ephemeral keypair in memory
RELAYER_PAYER_KEYPAIR=

# Email / Notifications (Optional: Server-Side Only via Cloudflare / Environment)
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Program IDs (Anchor on Solana Devnet)
HAICHAIN_PROGRAM_ID=Haid111111111111111111111111111111111111111
USDT_DEVNET_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
